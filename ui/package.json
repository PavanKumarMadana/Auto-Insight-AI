    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3", "framer-motion": "^12.23.12", "lucide-react": "^0.468.0", "react": "^18.3.1", "react-dom": "^18.3.1", "react-router-dom": "^7.18.4", "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11", "@types/react": "^18.3.28", "@types/react-dom": "^18.3.7", "@vitejs/plugin-react": "^4.7.0", "concurrently": "^9.2.1", "tailwindcss": "^4.1.11", "typescript": "~5.8.3", "vite": "^6.4.1"
  }
}
