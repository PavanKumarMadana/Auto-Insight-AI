{
  "name": "autoinsight-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:full": "concurrently -k \"npm:api\" \"npm:dev\"",
